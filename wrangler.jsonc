{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alumni-almun",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://alumni-almun.mohamadnabilmuzakki26.workers.dev",
    "EMAIL_FROM": "Alumni <no-reply@haloalumni.my.id>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alumni-db",
      // Ganti dengan ID dari `wrangler d1 create alumni-db`
      "database_id": "b30d9424-f0e2-4abd-855d-66c55c4e874b"
    }
  ],
  "routes": [
    { "pattern": "haloalumni.my.id", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "alumni-media","preview_bucket_name": "alumni-media"
    },
    {
      "binding": "PRIVATE",
      "bucket_name": "alumni-private","preview_bucket_name": "alumni-private"
    }
  ]
}
