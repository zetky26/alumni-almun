{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alumni-almun",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "alumni-almun.project-bb5.workers.dev",
    "EMAIL_FROM": "Alumni <alumni@almunawaroh.sch.id>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alumni-db",
      // Ganti dengan ID dari `wrangler d1 create alumni-db`
      "database_id": "d1ba1932-69e3-45c1-8c8f-4be76310b6eb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "alumni-media","preview_bucket_name": "alumni-media"
    },
    {
      "binding": "PRIVATE",
      "bucket_name": "alumni-private","preview_bucket_name": "alumni-private"
    }
  ]
}
